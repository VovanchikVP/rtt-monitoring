# --------- PostgreSQL ---------
APP_DB_USER=rtt
APP_DB_PASSWORD=rtt
APP_DB_HOST=localhost
APP_DB_NAME=rtt

# --------- RabbitMQ ---------
APP_RABBITMQ_HOST=localhost
APP_RABBITMQ_PORT=5672
APP_RABBITMQ_USER=rtt
APP_RABBITMQ_PASSWORD=rtt
APP_RABBITMQ_VHOST=/

# --------- Периодические задачи ---------
# поиск незаполненных турниров, секунды
APP_FILL_TOURS_INTERVAL=300
# час UTC: обновление очков игроков
APP_FILL_POINTS_HOUR=3
# час UTC: сверка составов предстоящих турниров
APP_SYNC_TOURS_HOUR=4
# час UTC: автоматический поиск новых турниров
APP_SEARCH_TOURS_HOUR=5
